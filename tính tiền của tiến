<script>

const PAY={

x74:{
name:"X74",
price:.80,
back:1,
b2:74,
b3:640,
b4:5200,
xc:640,
dd:74,
da2:540,
da1:700
},

x79:{
name:"X79",
price:.79,
back:1,
b2:75,
b3:640,
b4:5000,
xc:640,
dd:76,
da2:540,
da1:700
},

hanh:{
name:"Hạnh",
price:.76,
back:.95,
b2:75,
b3:650,
b4:5000,
xc:650,
dd:75,
da2:550,
da1:730
},

tuan:{
name:"Tuấn",
price:.77,
back:.95,
b2:75,
b3:650,
b4:5000,
xc:650,
dd:75,
da2:550,
da1:730
}

};


const $=id=>
document.getElementById(id);


const clean=s=>
String(s||"")
.toLowerCase()
.replace(/,/g,".")
.replace(/[–—−]/g,"-")
.trim();


function money(x){

return Math
.round(x)
.toLocaleString("vi-VN")
+"k";

}


function pts(s){

return parseFloat(
String(s)
.replace(",",".")
)||0;

}


function regionGroups(r){

return r==="B"
?27
:18;

}


function stationToken(t){

t=clean(t)
.replace(/[.:;]+$/,"");


if(
/^\d+d(mn|mt)$/.test(t)
){

return{

region:
t.endsWith("mn")
?"N"
:"T",

stations:+t[0],

label:
(+t[0])
+" Đài "
+(t.endsWith("mn")
?"MN"
:"MT")

};

}


if(
t==="hn"||
t==="mb"
){

return{

region:"B",
stations:1,
label:"Hà Nội/Bắc"

};

}


if(t==="dnai"){

return{

region:"N",
stations:1,
label:"Đồng Nai"

};

}


if(t==="ctho"){

return{

region:"N",
stations:1,
label:"Cần Thơ"

};

}


if(
t==="st"||
t==="sot"
){

return{

region:"N",
stations:1,
label:"Sóc Trăng"

};

}


if(
t==="dnang"||
t==="danang"
){

return{

region:"T",
stations:1,
label:"Đà Nẵng"

};

}


if(
t==="kh"||
t==="khanhhoa"
){

return{

region:"T",
stations:1,
label:"Khánh Hòa"

};

}


return null;

}


function numbersOf(s){

return String(s)

.replace(
/[,\s;]+/g,
"."
)

.replace(
/\.{2,}/g,
"."
)

.replace(
/^[.]+|[.]+$/g,
"")

.match(
/\d{2,4}/g
)||[];

}


function addBet(
rows,
st,
raw,
type,
p
){

let ns=numbersOf(raw);

if(!ns.length)
return;


let g=
regionGroups(
st.region
);

let gross=0;

let label=
type.toUpperCase();


if(type==="b"){

let d=
ns[0].length;

let pr;

if(
st.region==="B"
){

pr=
d===2
?27
:d===3
?23
:20;

}else{

pr=
d===2
?18
:d===3
?17
:16;

}


gross=
ns.length*
p*
pr*
st.stations;


label="B"+d;

}


else if(type==="xc"){

gross=
ns.length*
p*
4;

label="XC";

}


else if(type==="dd"){

gross=
ns.length*
p*
2*
st.stations;

label="DD";

}


else if(
type==="dau"||
type==="duoi"
){

gross=
ns.length*
p*
st.stations;

label=
type==="dau"
?"ĐẦU"
:"ĐUÔI";

}


else if(type==="da"){

gross=
ns.length*
(
ns.length-1
)*
g*
st.stations*
p;

label="DA";

}


else{

return;

}


rows.push({

region:st.region,

station:st.label,

numbers:ns,

type:label,

points:p,

gross

});

}


function parseLine(
line,
st,
rows,
errors
){

let s=
clean(line)
.replace(
/^[.;: -]+/,
""
);

if(!s)
return;


/*

Ví dụ:

917b0,5x10

517.856b0,5x3

26.62.67.76da0,5

*/

const re=
/(daoxc|dxc|xcdao|xcduoi|xduoi|xc|x|da|dv|bdao|daob|b|dd|dau|duoi)(\d+(?:\.\d+)?)(?:n)?/gi;


let m=
re.exec(s);

if(!m){

errors.push(line);

return;

}


let lastEnd=0;


while(m){

let nums=
s.slice(
lastEnd,
m.index
)
.replace(
/[.\s]+$/,
""
)
.trim();


let typ=
m[1].toLowerCase();


let p=
pts(m[2]);


let actual;


if(typ==="x")
actual="xc";

else if(typ==="dv")
actual="da";

else if(
typ==="xduoi"||
typ==="xcduoi"
)
actual="duoi";

else
actual=typ;


if(
actual.includes("dao")
){

errors.push(
"Chưa hỗ trợ cược đảo: "
+line
);

}else{

addBet(
rows,
st,
nums,
actual,
p
);

}


lastEnd=
m.index+m[0].length;


m=
re.exec(s);

}

}


function parseBets(){

let rows=[];
let errors=[];


let st={
region:"N",
stations:1,
label:"Mặc định"
};


for(
let line of
$("bets")
.value
.replace(/\r/g,"")
.split("\n")
){

let s=line.trim();

if(!s)
continue;


let token=
s.split(/\s+/)[0];


let q=
stationToken(token);


if(q){

st=q;

s=
s.slice(
token.length
)
.trim();


if(!s)
continue;

}


parseLine(
s,
st,
rows,
errors
);

}


return{
rows,
errors
};

}


function renderCalc(){

let data=
parseBets();

let rows=
data.rows;

let errors=
data.errors;

let rate=
PAY[
$("rate").value
];

let html="";

let grand=0;


for(
const [r,name]
of
[
["N","🄽 MIỀN NAM"],
["T","🅃 MIỀN TRUNG"],
["B","🅱 MIỀN BẮC"]
]
){

let a=
rows.filter(
x=>x.region===r
);


let g=
a.reduce(
(s,x)=>s+x.gross,
0
);


let thu=
g*
rate.price;


grand+=thu;


html+=`

<section class="card">

<div class="title">
${name}
</div>

<div class="stats">

<div class="stat">

<b>
${money(g)}
</b>

<small>
Tiền xác
</small>

</div>


<div class="stat">

<b>
0k
</b>

<small>
Tiền trúng
</small>

</div>


<div class="stat">

<b>
${money(thu)}
</b>

<small>
Thu trước trúng
</small>

</div>

</div>
`;


if(a.length){

html+=`

<div class="scroll">

<table>

<tr>

<th>
Phơi
</th>

<th>
Đài
</th>

<th>
Loại
</th>

<th>
Điểm
</th>

<th>
Tiền
</th>

</tr>

${
a.map(x=>`

<tr>

<td>
${x.numbers.join("–")}
</td>

<td>
${x.station}
</td>

<td>
<span class="pill">
${x.type}
</span>
</td>

<td>
${x.points}n
</td>

<td>
${x.gross}k
</td>

</tr>

`).join("")
}

</table>

</div>

`;

}


html+=`

</section>

`;

}


if(errors.length){

html+=`

<section class="card err">

<b>
Dòng chưa đọc:
</b>

<br>

${
errors
.map(
e=>e.replace(
/</g,
"&lt;"
)
)
.join("<br>")
}

</section>

`;

}


html+=`

<section class="card">

<b>
TỔNG XÁC:
${money(
rows.reduce(
(s,x)=>s+x.gross,
0
)
)}
</b>

<br>

<span class="muted">

Gốc ${rate.name}

—

Giá nhận ${rate.price}

</span>

</section>

`;


$("out").innerHTML=
html;

}


function dateURL(){

let d=
$("date").value
||
new Date()
.toISOString()
.slice(0,10);


return
"https://www.xosominhngoc.com/kqxs/"
+
d
.split("-")
.reverse()
.join("-")
+
".html";

}


function setStatus(
t,
cls=""
){

$("status")
.className=
"status "
+
cls;

$("status")
.innerHTML=t;

}


async function fetchText(url){

let direct=
await fetch(
url,
{
cache:"no-store"
}
)

.then(
r=>{
if(!r.ok)
throw Error(
"HTTP "
+r.status
);

return r.text();

}
)

.catch(
()=>null
);


if(direct)
return direct;


let proxy=
"https://api.allorigins.win/raw?url="
+
encodeURIComponent(url);


return fetch(
proxy,
{
cache:"no-store"
}
)

.then(
r=>{
if(!r.ok)
throw Error(
"Proxy HTTP "
+r.status
);

return r.text();

}
);

}


function parseResultText(text){

let doc=
new DOMParser()
.parseFromString(
text,
"text/html"
);


let body=
(
doc.body
?
doc.body.innerText
:""
)||"";


let out=[];


const re=
/KẾT QUẢ XỔ SỐ\s+([^-\n]+?)\s*-\s*(\d{2}\/\d{2}\/\d{4})/gi;


let m;

let starts=[];


while(
(m=re.exec(body))
){

starts.push({

name:
m[1].trim(),

at:m.index

});

}


for(
let i=0;
i<starts.length;
i++
){

let block=
body.slice(
starts[i].at,

i+1<starts.length
?
starts[i+1].at
:
body.length
);


let name=
starts[i].name;


let region;


if(
/Bắc Ninh|Miền Bắc|Hà Nội/i
.test(name)
){

region="B";

}

else if(
/Đà Nẵng|
Khánh Hòa|
Quảng Nam|
Đắk Lắk|
Bình Định|
Gia Lai|
Phú Yên|
Quảng Ngãi|
Kon Tum|
Ninh Thuận/i
.test(name)
){

region="T";

}

else{

region="N";

}


let prizes={

db:[],
g1:[],
g2:[],
g3:[],
g4:[],
g5:[],
g6:[],
g7:[],
g8:[]

};


const labs=[

["db","Giải ĐB"],
["g1","Giải nhất"],
["g2","Giải nhì"],
["g3","Giải ba"],
["g4","Giải tư"],
["g5","Giải năm"],
["g6","Giải sáu"],
["g7","Giải bảy"],
["g8","Giải 8"]

];


for(
let j=0;
j<labs.length;
j++
){

let next=
j+1<labs.length
?
labs[j+1][1]
:
"Chục Số Đ.Vị";


let rr=
new RegExp(

labs[j][1]
.replace(
/[.*+?^${}()|[\]\\]/g,
"\\$&"
)
+
"\\s+([0-9\\s]+?)(?=\\s+"
+
next
.replace(
/[.*+?^${}()|[\]\\]/g,
"\\$&"
)
+
"\\s+|$)",

"i"

);


let z=
block.match(rr);


if(z){

prizes[
labs[j][0]
]
=
z[1]
.match(
/\d{2,6}/g
)||[];

}

}


for(
const [k,label]
of labs
){

if(
!prizes[k].length
){

let ix=
block.indexOf(label);


if(ix>=0){

let tail=
block.slice(
ix+label.length,
ix+label.length+250
);


prizes[k]=
tail.match(
/\d{2,6}/g
)||[];

}

}

}


let all=
Object.values(prizes)
.flat();


if(all.length){

out.push({

name,

region,

prizes,

all

});

}

}


return out;

}


function resultTextForScan(){

if(
$("manual")
.value.trim()
)
return $("manual").value;

return
window.__RESULT_TEXT||"";

}


function normalize2(s){

return String(s)
.padStart(2,"0")
.slice(-2);

}


function normalize3(s){

return String(s)
.padStart(3,"0")
.slice(-3);

}


function normalize4(s){

return String(s)
.padStart(4,"0")
.slice(-4);

}


function hitsForBet(
bet,
results
){

let hits=[];


for(
const rr of results
){

if(
rr.region!==bet.region
)
continue;


for(
const n of bet.numbers
){

let want;

if(
n.length===2
)
want=
normalize2(n);

else if(
n.length===3
)
want=
normalize3(n);

else
want=
normalize4(n);


let found=
rr.all.some(
v=>
v===want
||
v.slice(
-want.length
)===want
);


if(found){

hits.push({

station:rr.name,

num:want

});

}

}

}


return hits;

}


function scan(){

let results=
window.__RESULTS||[];


if(!results.length){

setStatus(
"Chưa có KQ. Bấm LẤY KQ 3 MIỀN hoặc dán KQ thủ công.",
"err"
);

return;

}


let data=
parseBets();

let rows=
data.rows;

let html="";

let hitCount=0;


for(
const [r,name]
of
[
["N","🄽 MIỀN NAM"],
["T","🅃 MIỀN TRUNG"],
["B","🅱 MIỀN BẮC"]
]
){

let a=
rows.filter(
x=>x.region===r
);


html+=`

<section class="card">

<div class="title">
${name}
</div>

<div class="scroll">

<table>

<tr>

<th>
Phơi
</th>

<th>
Đài
</th>

<th>
Loại
</th>

<th>
Điểm
</th>

<th>
Dò
</th>

</tr>

`;


for(
const b of a
){

let h=
hitsForBet(
b,
results
);


let hit=
h.length>0;


hitCount+=h.length;


html+=`

<tr class="${
hit
?"hit"
:"miss"
}">

<td>
${b.numbers.join("–")}
</td>

<td>
${b.station}
</td>

<td>
${b.type}
</td>

<td>
${b.points}n
</td>

<td>

${
hit
?
'<span class="hitnum">TRÚNG: '
+
h.map(
x=>
x.num
+
" ("
+
x.station
+
")"
)
.join(", ")
+
"</span>"
:
"—"
}

</td>

</tr>

`;

}


html+=`

</table>

</div>

</section>

`;

}


html+=`

<section class="card">

<b>
🔎 Kết quả dò:
${hitCount}
lượt trùng
</b>

<br>

<span class="muted">

Phần mềm xác định số có xuất hiện
trong kết quả.

Phần tiền trả thưởng chi tiết từng
loại cược cần bảng trả thưởng riêng
của máy.

</span>

</section>

`;


$("out").innerHTML=
html;


setStatus(
"Đã dò xong.",
"ok"
);

}


$("calc").onclick=
renderCalc;


$("scan").onclick=
scan;


$("get").onclick=
async()=>{

let url=
dateURL();


setStatus(
"Đang lấy: "
+
url
);


try{

let text=
await fetchText(url);


window.__RESULT_TEXT=
text;


window.__RESULTS=
parseResultText(text);


$("results")
.innerHTML=
window.__RESULTS
.map(
x=>
`<div>
<b>${x.name}</b>
— ${x.all.length} số
</div>`
)
.join("");


setStatus(
"Đã lấy KQ "
+
window.__RESULTS.length
+
" đài. Bấm TỰ DÒ.",
"ok"
);


}catch(e){

setStatus(

"Không lấy được trực tiếp. "
+
"Hãy dán KQ vào ô dự phòng "
+
"rồi bấm TỰ DÒ. "
+
"Lỗi: "
+
e.message,

"err"

);

}

};


$("manual")
.addEventListener(
"input",
()=>{

let t=
$("manual")
.value
.trim();


if(!t)
return;


window.__RESULT_TEXT=
t;


window.__RESULTS=
parseResultText(t);


if(
window.__RESULTS.length
){

$("results")
.innerHTML=
window.__RESULTS
.map(
x=>
`<div>
<b>${x.name}</b>
— ${x.all.length} số
</div>`
)
.join("");

}

});


$("clear").onclick=
()=>{

$("bets").value="";

$("manual").value="";

$("out").innerHTML="";

$("results").innerHTML=
"Chưa có dữ liệu.";

window.__RESULTS=[];

setStatus(
"Đã xóa."
);

};


$("date").value=
new Date()
.toISOString()
.slice(0,10);

</script>

